{
  "name": "waas-example-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Waaskey React example — embedded MPC wallet: email-OTP login, in-browser keygen, wallet widget",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "start": "vite",
    "start:prod": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "types": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@waaskey/client-wasm": "0.2.1",
    "@waaskey/react": "0.2.0",
    "@waaskey/sdk": "0.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0"
  }
}
